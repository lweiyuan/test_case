# ===========================================================
# 部门 AI 配置示例（请复制为 .env 并填入真实信息）
# 文档: 部署与使用.docx (天蝎AI部署及操作)
# 协议: OpenAI-compatible /v1
# ===========================================================

# API 端点（公司内网）
OPENAI_API_BASE=http://<dept-ai-host>:<port>/v1
OPENAI_BASE_URL=http://<dept-ai-host>:<port>/v1
KIMI_BASE_URL=http://<dept-ai-host>:<port>/v1

# API Key（找部门接口人领取，每个人独立一个）
OPENAI_API_KEY=<your-api-key>
KIMI_API_KEY=<your-api-key>

# 默认模型名（部门接口人实查 GET /v1/models 即可）
# 例: deepseek-v4-flash-0731 / minimax-m3 / qwen-coder 等
OPENAI_MODEL=deepseek-v4-flash-0731
KIMI_MODEL=deepseek-v4-flash-0731
